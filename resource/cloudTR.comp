#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform Camera
{
	vec3 pos;
	mat4 view;
	mat4 proj;
	mat4 invView;
	mat4 invProj;
} camera;

layout(set = 1, binding = 0) uniform TRP
{
	vec3 pos;
	mat4 viewProj;
	float historyWeight;
	uint historyValid;
} trp;

layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D trOutput;
layout(set = 1, binding = 2, r32f) uniform writeonly image2D trDepth;
layout(set = 1, binding = 3) uniform sampler2D curCloudTex;
layout(set = 1, binding = 4) uniform sampler2D curCloudDepthTex;
layout(set = 1, binding = 5) uniform sampler2D prevCloudTex;
layout(set = 1, binding = 6, r8ui) uniform uimage2D accumTex;

vec3 PixelToViewPos(vec2 uv, float z)
{
	vec3 ndc = vec3(uv * 2.0 - 1.0, z);
	ndc.y = -ndc.y;
	vec4 viewPos = camera.invProj * vec4(ndc, 1.0);
	viewPos /= viewPos.w;
	return viewPos.xyz;
}

vec2 PreviousCloudUV(vec3 rayDir, float cloudDepth)
{
	if (cloudDepth < 0.0 || isnan(cloudDepth) || isinf(cloudDepth))
		return vec2(-1.0);
	const vec3 curCloudPos = camera.pos + rayDir * cloudDepth;
	const vec4 prevClip = trp.viewProj * vec4(curCloudPos, 1.0);
	if (prevClip.w <= 0.0)
		return vec2(-1.0);
	const vec2 prevNDC = prevClip.xy / prevClip.w;
	vec2 prevUV = prevNDC * 0.5 + 0.5;
	prevUV.y = 1.0 - prevUV.y;
	return prevUV;
}

