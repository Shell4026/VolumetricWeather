#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform Camera
{
	vec3 pos;
	mat4 view;
	mat4 proj;
	mat4 invView;
	mat4 invProj;
} camera;

layout(set = 1, binding = 0) uniform TRP
{
	vec3 pos;
	mat4 viewProj;
	
	float historyWeight;
	uint historyValid;
	float nhGamma;
	uint frameIdx;
} trp;

layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D trOutput;
layout(set = 1, binding = 2) uniform sampler2D curCloudTex;
layout(set = 1, binding = 3) uniform sampler2D curCloudDepthTex;
layout(set = 1, binding = 4) uniform sampler2D prevCloudTex;
layout(set = 1, binding = 5, r8ui) uniform uimage2D accumTex;

const ivec2 BAYER_22[4] = ivec2[]
(
	ivec2(0, 0),
	ivec2(1, 1),
	ivec2(1, 0),
	ivec2(0, 1)
);

bool IsCurrentFramePixel(ivec2 pixel)
{
	return all(equal(pixel & ivec2(1), BAYER_22[trp.frameIdx % 4]));
}

bool IsCloudOccluded(float cloudDepth)
{
	return cloudDepth < -1.5;
}

vec3 PixelToViewPos(vec2 uv, float z)
{
	vec3 ndc = vec3(uv * 2.0 - 1.0, z);
	ndc.y = -ndc.y;
	vec4 viewPos = camera.invProj * vec4(ndc, 1.0);
	viewPos /= viewPos.w;
	return viewPos.xyz;
}

vec2 PreviousUV(vec3 rayDir)
{
	const vec3 curPos = camera.pos + rayDir * 100000;
	const vec4 prevClip = trp.viewProj * vec4(curPos, 1.0);
	if (prevClip.w <= 0.0)
		return vec2(-1.0);
	const vec2 prevNDC = prevClip.xy / prevClip.w;
	vec2 prevUV = prevNDC * 0.5 + 0.5;
	prevUV.y = 1.0 - prevUV.y;
	return prevUV;
}

bool CurrentNeighborhood(ivec2 pixel, out vec4 mean, out vec4 stddev)
{
    const ivec2 size = textureSize(curCloudTex, 0);
    vec4 m1 = vec4(0.0);
    vec4 m2 = vec4(0.0);
	float count = 0.0;
    for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			const ivec2 coord = clamp(pixel + ivec2(x, y), ivec2(0), size - ivec2(1));
			const float z = texelFetch(curCloudDepthTex, coord, 0).r;
			if (IsCloudOccluded(z))
                continue;
			const vec4 c = texelFetch(curCloudTex, coord, 0);
			m1 += c;
			m2 += c * c;
			count += 1.0;
		}
	}
    mean = vec4(0.0);
    stddev = vec4(0.0);
    if (count == 0.0)
        return false;
    mean = m1 / count;
    stddev = sqrt(max(m2 / count - mean * mean, 0.0));
    return true;
}

vec4 ClampToNeighborhood(vec4 history, ivec2 pixel, ivec2 size)
{
    vec4 mean, stddev;
    if (!CurrentNeighborhood(pixel, mean, stddev))
        return history;
    const vec4 gamma = trp.nhGamma * stddev;
    const vec4 boxMin = max(mean - gamma, 0.0);
    vec4 boxMax = mean + gamma;
    boxMax.a = min(boxMax.a, 1.0);
    return clamp(history, boxMin, boxMax);
}

// 히스토리를 쓸 수 없을 때의 값. 같은 2x2 블록의 새 값, 그게 가려졌으면 가려지지 않은 이웃의 평균
vec4 FallbackCloud(ivec2 pixel, ivec2 size)
{
	// Pixel & ~1 : 현재 2x2블록의 원점
	const ivec2 freshXY = min((pixel & ~1) + BAYER_22[trp.frameIdx % 4], size - 1);
	const float z = texelFetch(curCloudDepthTex, freshXY, 0).r;
	if (!IsCloudOccluded(z))
        return texelFetch(curCloudTex, freshXY, 0);
    vec4 mean, stddev;
    if (CurrentNeighborhood(pixel, mean, stddev))
        return mean;
    return vec4(0.0, 0.0, 0.0, 1.0);
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	
	const ivec2 size = imageSize(trOutput);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	const vec3 viewRay = PixelToViewPos(uv, 1.0);
	const vec3 rayDir = normalize((camera.invView * vec4(viewRay, 0.0)).xyz);
	uint accum = imageLoad(accumTex, pixel).r;
	
	const vec4 curCloud = texelFetch(curCloudTex, pixel, 0);
	const float curDepth = texelFetch(curCloudDepthTex, pixel, 0).r;
	
	const bool bCurrentFramePixel = IsCurrentFramePixel(pixel);
	const bool bOccluded = bCurrentFramePixel && IsCloudOccluded(curDepth);
	
	if (bCurrentFramePixel && !bOccluded && curDepth < 0.0)
	{
		imageStore(accumTex, pixel, ivec4(0));
		imageStore(trOutput, pixel, curCloud);
		return;
	}
	if (trp.historyValid == 0)
	{
		imageStore(accumTex, pixel, ivec4(0));
		imageStore(trOutput, pixel, FallbackCloud(pixel, size));
		return;
	}
	
	float maxHistoryWeight = clamp(trp.historyWeight, 0.0, 0.99);
	vec2 historyUV = PreviousUV(rayDir);
	if (trp.historyValid == 1) // 움직이는 상태
		maxHistoryWeight = max(0.0, maxHistoryWeight * 0.5);

	if (historyUV.x < 0.0 || historyUV.x >= 1.0 || historyUV.y < 0.0 || historyUV.y >= 1.0)
	{
		imageStore(accumTex, pixel, ivec4(0));
		imageStore(trOutput, pixel, FallbackCloud(pixel, size));
		return;
	}
	
	vec4 prevCloud = texture(prevCloudTex, historyUV);
	if (!bCurrentFramePixel) // 이번 프레임에 계산하지 않은 픽셀은 재투영 결과를 그대로
	{
        if (accum == 0)
            prevCloud = FallbackCloud(pixel, size);
		imageStore(trOutput, pixel, prevCloud);
		return;
	}

	float historyWeight = min(accum / float(accum + 1), maxHistoryWeight);
	accum = min(accum + 1, 16);

	prevCloud = ClampToNeighborhood(prevCloud, pixel, size);
	
	const vec3 inScattering = mix(curCloud.rgb, prevCloud.rgb, historyWeight);
	const float transmittance = mix(curCloud.a, prevCloud.a, historyWeight);
	
	imageStore(accumTex, pixel, ivec4(accum));
	imageStore(trOutput, pixel, vec4(inScattering, transmittance));
}
