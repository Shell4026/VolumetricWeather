vec4 ClipAABB(vec4 boxMin, vec4 boxMax, vec4 historyColor)
{
	const vec4 center = (boxMax + boxMin) * 0.5;
	const vec4 extents = (boxMax - boxMin) * 0.5 + 1e-5;

	const vec4 rayDir = historyColor - center;
	const vec4 rayDirUnit = abs(rayDir / extents);
	const float maxUnit = max(max(rayDirUnit.x, rayDirUnit.y), max(rayDirUnit.z, rayDirUnit.w));
	
	return (maxUnit > 1.0) ? center + rayDir / maxUnit : historyColor;
}

void CurrentNeighborhood(ivec2 pixel, out vec4 mean, out vec4 stddev)
{
    const ivec2 size = textureSize(curCloudTex, 0);
    vec4 m1 = vec4(0.0);
    vec4 m2 = vec4(0.0);
    for (int y = -1; y <= 1; ++y)
	{
    for (int x = -1; x <= 1; ++x)
		{
			const ivec2 coord = clamp(pixel + ivec2(x, y), ivec2(0), size - ivec2(1));
			const vec4 c = texelFetch(curCloudTex, coord, 0);
			m1 += c;
			m2 += c * c;
		}
	}
    mean = m1 / 9.0;
    const vec4 variance = max(m2 / 9.0 - mean * mean, vec4(0.0));
    stddev = sqrt(variance);
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 size = imageSize(trOutput);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	const vec3 viewRay = PixelToViewPos(uv, 1.0);
	const vec3 rayDir = normalize((camera.invView * vec4(viewRay, 0.0)).xyz);
	uint accum = imageLoad(accumTex, pixel).r;
	
	const vec4 curCloud = texelFetch(curCloudTex, pixel, 0);
	const float curDepth = texelFetch(curCloudDepthTex, pixel, 0).r;
	imageStore(trDepth, pixel, vec4(curDepth));
	if (trp.historyValid == 0)
	{
		imageStore(accumTex, pixel, ivec4(0));
		imageStore(trOutput, pixel, curCloud);
		return;
	}
	if (curDepth < 0.0)
	{
		imageStore(accumTex, pixel, ivec4(0));
		imageStore(trOutput, pixel, curCloud);
		return;
	}
	const vec2 historyUV = PreviousCloudUV(rayDir, curDepth);
	if (historyUV.x < 0.0 || historyUV.x >= 1.0 || historyUV.y < 0.0 || historyUV.y >= 1.0)
	{
		imageStore(accumTex, pixel, ivec4(0));
		imageStore(trOutput, pixel, curCloud);
		return;
	}
	vec4 prevCloud = texture(prevCloudTex, historyUV);
	const float maxHistoryWeight = clamp(trp.historyWeight, 0.0, 0.99);
	float historyWeight = min(accum / float(accum + 1), maxHistoryWeight);
	
	vec4 mean, stddev;
	CurrentNeighborhood(pixel, mean, stddev);
	const vec4 gamma = 1.25 * stddev;
	vec4 boxMin = max(mean - gamma, vec4(0.0));
	vec4 boxMax = mean + gamma;
	boxMax.a = min(boxMax.a, 1.0);
	prevCloud = ClipAABB(boxMin, boxMax, prevCloud);
	
	// vec4 neighborhoodMin;
	// vec4 neighborhoodMax;
	// CurrentNeighborhoodBounds(pixel, neighborhoodMin, neighborhoodMax);
	// const vec4 neighborhoodPadding = max((neighborhoodMax - neighborhoodMin) * 0.25, vec4(0.01));
	// neighborhoodMin -= neighborhoodPadding;
	// neighborhoodMax += neighborhoodPadding;
	// neighborhoodMin = max(neighborhoodMin, vec4(0.0));
	// neighborhoodMax.a = min(neighborhoodMax.a, 1.0);
	// prevCloud = clamp(prevCloud, neighborhoodMin, neighborhoodMax);
	
	const vec3 inScattering = mix(curCloud.rgb, prevCloud.rgb, historyWeight);
	const float transmittance = mix(curCloud.a, prevCloud.a, historyWeight);
	
	accum = min(accum + 1, 16);
	imageStore(accumTex, pixel, ivec4(accum));
	imageStore(trOutput, pixel, vec4(inScattering, transmittance));
}
