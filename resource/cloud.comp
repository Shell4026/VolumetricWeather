vec2 GetTransmittanceUV(vec3 samplePos, vec3 dir)
{
	const vec3 PLANET_CENTER = vec3(0.0, -setting.groundRadius, 0.0);
	
	const float sampleLength = length(samplePos - PLANET_CENTER);
	const float height = sampleLength - setting.groundRadius;
	const vec3 up = (samplePos - PLANET_CENTER) / sampleLength;
	const float mu = dot(up, dir);
	
	const float r = height + setting.groundRadius;
	// 지평선에서 대기까지의 거리 H
	const float H = sqrt(setting.atmosphereRadius * setting.atmosphereRadius - setting.groundRadius * setting.groundRadius);
	// 지평선 거리 rho
	const float rho = sqrt(r * r - setting.groundRadius * setting.groundRadius);
	
	const float dMin = setting.atmosphereRadius - r; // 머리 위의 대기까지의 거리
	const float dMax = rho + H; // 지평선 너머의 대기까지의 거리
	float d = -r * mu + sqrt(r * r * (mu * mu - 1) + setting.atmosphereRadius * setting.atmosphereRadius); // 샘플에서 ray방향으로의 대기권까지의 거리
	d = max(d, 0.0);
	
	float u = (d - dMin) / (dMax - dMin); // 0(머리위) ~ 1(지평선)
	float v = rho / H; // 그냥 높이 비율 대신 제곱근 비율로 바뀐거
	v = 1.0 - v;
	return vec2(u, v);
}

vec3 TransmittanceUsingLUT(vec3 samplePos, vec3 dir)
{
	const ivec2 size = textureSize(transmittanceLUT, 0);
	vec2 uv = GetTransmittanceUV(samplePos, dir);
	uv = (vec2(0.5) + uv * (size - vec2(1.0))) / size;
	
	return texture(transmittanceLUT, uv).xyz;
}

void SegmentTransmittance(
	vec3 rayOrigin, 
	vec3 rayDir, 
	vec2 segment, 
	float steps, 
	vec2 noise,
	vec3 sunDir, 
	float phase,
	float mu,
	inout vec3 inScattering,
	inout float transmittance,
	inout float depthSum,
	inout float weightSum)
{
	const vec3 PLANET_CENTER = vec3(0.0, -setting.groundRadius, 0.0);
	const float cloudInner = setting.groundRadius + CLOUD_HEIGHT;
	const float cloudOuter = cloudInner + CLOUD_THICKNESS;
	const float segmentLength = segment.y - segment.x;
	const float targetStepLength = 500.0;
	const uint maxStep = max(uint(steps), 1u);
	const uint minStep = min(5u, maxStep);
	steps = clamp(uint(ceil(segmentLength / targetStepLength)), minStep, maxStep);
	const float stepSize = segmentLength / steps;
	const bool lightViewLimit = (setting.modeFlags & 1) == 1;
	// const float CONE_ROTATION_SEQUENCE[8] = float[](0.0, 0.5, 0.25, 0.75, 0.125, 0.625, 0.375, 0.875);
	// const float temporalConeRotation = CONE_ROTATION_SEQUENCE[setting.frame & 7u];
	// const float sunHorizonFactor = 1.0 - smoothstep(0.08, 0.30, abs(sunDir.y));

	for (uint i = 0; i < steps; ++i)
	{
		if (transmittance <= 0.01)
            break;
		const float t = segment.x + stepSize * (i + noise.r);
		const vec3 samplePos = rayOrigin + rayDir * t;
		const float density = GetDensity(cloudInner, cloudOuter, samplePos);
		if (density <= 0.001)
			continue;
		
		float lightViewOpticalDepth = 0.0;
		vec3 lightViewT = vec3(1.0);
		float groundNear;
		float groundFar;
		
		if (RaySphereIntersect(samplePos, -sunDir, PLANET_CENTER, setting.groundRadius, groundNear, groundFar))
			lightViewT = vec3(0.0);
		else
		{
			lightViewT *= TransmittanceUsingLUT(samplePos, -sunDir);
			vec2 seg0;
			vec2 seg1;
			int segCount = RayCloudShellIntersect(samplePos, -sunDir, PLANET_CENTER, cloudInner, cloudOuter, seg0, seg1);
			// if (segCount >= 1)
			// {
				// float maxLightDistance = segCount == 2 ? seg1.y : seg0.y;
				// maxLightDistance = min(lightViewLimit ? 64000.0 : 128000.0, maxLightDistance);

				// const float worldConeRotation = 0.03125 *
					// (1.0 + sin(dot(samplePos.xz, vec2(0.00031, 0.00023))));
				// const float temporalShadowAmount = smoothstep(0.05, 0.25, density);
				// const float sampleConeRotation = fract(
					// Hash(float(i) + 13.0) +
					// sunHorizonFactor *
					// (worldConeRotation + temporalConeRotation * temporalShadowAmount));
				// lightViewOpticalDepth = CloudLightConeOpticalDepth(
					// samplePos, -sunDir, maxLightDistance,
					// cloudInner, cloudOuter,
					// sampleConeRotation);
				// lightViewT *= exp(-lightViewOpticalDepth);
			// }
			if (segCount >= 1)
			{
				float seg0Length = seg0.y - seg0.x;
				seg0Length = lightViewLimit ? min(64000, seg0Length) : seg0Length;
				const vec3 seg0Pos = samplePos - sunDir * seg0.x;
				const float seg0CloudLightViewT = CloudToSunTransmittance(
					seg0Pos, seg0Pos - sunDir * seg0Length, 
					seg0Length, setting.lightViewSteps, cloudInner, cloudOuter, mu, noise.g);
				if (segCount == 1)
					lightViewT *= seg0CloudLightViewT;
				else if (segCount == 2)
				{
					float seg1Length = seg1.y - seg1.x;
					seg1Length = lightViewLimit ? min(64000, seg1Length) : seg1Length;
					const vec3 seg1Pos = samplePos - sunDir * seg1.x;
					const float seg1CloudLightViewT = CloudToSunTransmittance(
						seg1Pos, seg1Pos - sunDir * seg1Length, 
						seg1Length, setting.lightViewSteps, cloudInner, cloudOuter, mu, noise.g);
					lightViewT *= seg1CloudLightViewT;
				}
			}
		}
		
		const float sigmaA = 4.4 * 1e-6 * setting.extinctionCoefficient;
		const float sigmaT = density * sigmaA;
		const float stepTransmittance = exp(-sigmaT * stepSize);
		const float stepTransmittanceAlpha = 1.0 - stepTransmittance;
		const float depthWeight = transmittance * stepTransmittanceAlpha;
		depthSum += t * depthWeight;
		weightSum += depthWeight;
		const float powder = 1.0;//powder = 1.0 - exp(-2.0 * setting.powderStrength * sigmaT * stepSize);
		inScattering += transmittance * stepTransmittanceAlpha * (lightViewT * powder * phase * setting.sun.w);
		transmittance *= stepTransmittance;
	}
}

int ClipCloudSegments(float maxDistance, inout vec2 segment0, inout vec2 segment1, int segmentCount)
{
	if (segmentCount <= 0 || maxDistance <= segment0.x)
		return 0;
	segment0.y = min(segment0.y, maxDistance);
	if (segment0.y <= segment0.x)
		return 0;
	if (segmentCount == 1 || maxDistance <= segment1.x)
		return 1;
	segment1.y = min(segment1.y, maxDistance);
	if (segment1.y <= segment1.x)
		return 1;
	return 2;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outImage);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	// float perlinWorley = texture(perlin, vec3(uv * 5.0, 0.0)).r;
	// vec3 worley = texture(perlin, vec3(uv, 0.0)).gba;
	
	// float wfbm = worley.r * 0.625 + worley.g * 0.125 + worley.b * 0.25;
	// float cloud = Remap(perlinWorley, wfbm - 1.0, 1.0, 0.0, 1.0);
	// cloud = clamp(Remap(cloud, 1.0 - setting.coverage, 1.0, 0.0, 1.0), 0.0, 1.0);
	// imageStore(outImage, pixel, vec4(vec3(cloud), 1.0));
	// return;
	
	const vec3 viewRay = PixelToViewPos(uv, 1.0);
	const vec3 rayDir = normalize((camera.invView * vec4(viewRay, 0.0)).xyz);
	const float cloudInnerRadius = setting.groundRadius + CLOUD_HEIGHT;
	const float cloudOuterRadius = cloudInnerRadius + CLOUD_THICKNESS;
	const vec3 PLANET_CENTER = vec3(0.0, -setting.groundRadius, 0.0);
	const ivec2 noisePixel = pixel % textureSize(noiseTex, 0);
	const vec2 bluseNoise = texelFetch(noiseTex, noisePixel, 0).rg;

	const vec2 noise = fract(bluseNoise + setting.frame * 0.61803398875);
	vec2 cloudSegment0;
	vec2 cloudSegment1;
	int cloudSegmentCount = 
		RayCloudShellIntersect(camera.pos, rayDir, PLANET_CENTER, cloudInnerRadius, cloudOuterRadius, cloudSegment0, cloudSegment1);
	if (cloudSegmentCount == 0)
	{
		imageStore(outImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outCloudDepth, pixel, vec4(-1.0));
		return;
	}

	const float z = texture(sceneDepth, uv).r;
	const vec3 viewPos = PixelToViewPos(uv, z);
	const float sceneDistance = length(viewPos);
	if (z < 1.0)
		cloudSegmentCount = ClipCloudSegments(sceneDistance, cloudSegment0, cloudSegment1, cloudSegmentCount);
	if (cloudSegmentCount == 0)
	{
		imageStore(outImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outCloudDepth, pixel, vec4(-1.0));
		return;
	}
	
	const vec3 sunDir = setting.sun.xyz;
	const float mu = dot(rayDir, -sunDir);
	const float phase = mix(MiePhase(mu, 0.8), MiePhase(mu, -0.2), 0.5);

	vec3 inScattering = vec3(0.0);
	float transmittance = 1.0;
	float depthSum = 0.0;
	float weightSum = 0.0;
	if (cloudSegmentCount == 1)
	{
		SegmentTransmittance(
			camera.pos, rayDir, cloudSegment0, setting.steps, noise,
			sunDir, phase, mu, 
			inScattering, transmittance, depthSum, weightSum);
	}
	else if (cloudSegmentCount == 2)
	{
		SegmentTransmittance(
			camera.pos, rayDir, cloudSegment0, setting.steps, noise,
			sunDir, phase, mu,
			inScattering, transmittance, depthSum, weightSum);
		SegmentTransmittance(
			camera.pos, rayDir, cloudSegment1, setting.steps, noise,
			sunDir, phase, mu,
			inScattering, transmittance, depthSum, weightSum);
	}

	const float fallbackDepth = mix(cloudSegment0.x, cloudSegment0.y, 0.3);
	const float weightedDepth = depthSum / max(weightSum, 1e-5);
	const float depthReliability = smoothstep(0.005, 0.05, weightSum);
	const float depth = mix(fallbackDepth, weightedDepth, depthReliability);
	
	imageStore(outImage, pixel, vec4(inScattering, transmittance));
	imageStore(outCloudDepth, pixel, vec4(depth));
}
