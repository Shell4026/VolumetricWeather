#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform Camera
{
	vec3 pos;
	mat4 view;
	mat4 proj;
	mat4 invView;
	mat4 invProj;
} camera;

struct Bezier
{
	vec2 a;
	vec2 b;
	vec2 c;
	vec2 d;
};

layout(set = 1, binding = 0) uniform Setting
{
	uint steps;
	uint lightViewSteps;
	uint modeFlags;
	uint frameIdx;
	
	float time;
	float tiling;
	float tiling2;
	float extinctionCoefficient;
	
	float coverage;
	float powderStrength;
	float anvilBias;
	float darkness;
	
	Bezier darknessHeight;
	
	float densityPMin;
	float densityPFactor;
	vec2 windVelKmh;
} setting;
layout(set = 1, binding = 1) uniform Atmosphere
{
	float groundRadius;
	float atmosphereRadius;
	float mieCoefficient;
	float mieG;
	
	vec3 mieColor; // 3.996, 3.996, 3.996
	
	vec3 rayleighColor; // 5.802, 13.558, 33.1
} atmosphere;
layout(set = 1, binding = 2) uniform Lighting
{
	vec4 sun; // dir, illuminance
	mat4 sunViewProj;
} lighting;
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2D outImage;
layout(set = 1, binding = 4, r32f) uniform writeonly image2D outCloudDepth;
layout(set = 1, binding = 5) uniform sampler3D perlin;
layout(set = 1, binding = 6) uniform sampler2D noiseTex;
layout(set = 1, binding = 7) uniform sampler2D sceneDepth;
layout(set = 1, binding = 8) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 9) uniform sampler2D cloudMaskTex;

const float CLOUD_HEIGHT = 2000;
const float CLOUD_THICKNESS = 5000;
const float PI = 3.14159265;

vec3 PixelToViewPos(vec2 uv, float z)
{
	vec3 ndc = vec3(uv * 2.0 - 1.0, z);
	ndc.y = -ndc.y;
	vec4 viewPos = camera.invProj * vec4(ndc, 1.0);
	viewPos /= viewPos.w;
	return viewPos.xyz;
}

float MiePhase(float mu, float g)
{
	float g2 = g * g;
	return 3 * (1 - g2) * (1 + mu * mu) / (8 * PI * (2 + g2) * pow(1 + g2 - 2 * g * mu, 1.5));
}

// 구 내부에서 쏜 경우 near은 음수가 나옴
bool RaySphereIntersect(vec3 rayOrigin, vec3 rayDir, vec3 sphereOrigin, float radius, out float near, out float far)
{
	vec3 rs = sphereOrigin - rayOrigin;
	float a2 = dot(rs, rs);
	float b = dot(rs, rayDir);
	float c2 = a2 - b * b;
	float r2 = radius * radius;
	if (c2 > r2)
		return false;
	
	float d = sqrt(r2 - c2); // 구 내부 ray길이
	near = b - d;
	far = b + d;
	
	return far >= 0.0;
}

// 구름층을 통과하는 구간 갯수를 반환
// 지상에서 밖 [innerFar, outerFar]
// 구름층 내부에서 밖 [0, outerFar]
// 구름층 내부에서 안 [0, innerNear] [innerFar, outerFar] 
// 우주에서 행성 관통X [outerNear, outerFar]
// 우주에서 행성 관통O [outerNear, innerNear]
int RayCloudShellIntersect(vec3 rayOrigin, vec3 rayDir, vec3 center, float innerRadius, float outerRadius, out vec2 segment0, out vec2 segment1)
{
	segment0 = vec2(0.0);
	segment1 = vec2(0.0);

	float outerNear;
	float outerFar;
	if (!RaySphereIntersect(rayOrigin, rayDir, center, outerRadius, outerNear, outerFar))
		return 0; // 우주에서 우주
	outerNear = max(outerNear, 0.0);
	if (outerFar <= outerNear)
		return 0;
	
	float innerNear;
	float innerFar;
	// 내부층과 충돌x => 우주에서 구름 외부층만 보거나, 구름 내부에서 밖을 봄
	if (!RaySphereIntersect(rayOrigin, rayDir, center, innerRadius, innerNear, innerFar))
	{
		segment0 = vec2(outerNear, outerFar);
		return 1;
	}
	
	// 여기서부터 내부구를 볼 수 있는 상태
	float groundNear;
	float groundFar;
	const bool bGroundHit = RaySphereIntersect(rayOrigin, rayDir, center, atmosphere.groundRadius, groundNear, groundFar);
	if (innerNear > 0.0)
	{
		segment0 = vec2(outerNear, innerNear);
		if (bGroundHit && groundNear > 0.0) // 구름층/우주에서 땅을 보는 상태
			return 1;
		segment1 = vec2(innerFar, outerFar);
		return 2;
	}
	
	if (bGroundHit) // 지상에서 땅
		return 0;
	
	segment0 = vec2(innerFar, outerFar); // 지상에서 밖
	return 1;
}

float Hash(float x)
{
    return fract(sin(x) * 43758.5453123);
}

float Remap(float value, float originalMin, float originalMax, float newMin, float newMax)
{
	return newMin + ((value - originalMin) / (originalMax - originalMin)) * (newMax - newMin);
}
float RemapClamp(float value, float originalMin, float originalMax, float newMin, float newMax)
{
	return clamp(Remap(value, originalMin, originalMax, newMin, newMax), newMin, newMax);
}

float BezierCurve(Bezier bezier, float t)
{
	const vec2 a = bezier.a;
	const vec2 b = bezier.b;
	const vec2 c = bezier.c;
	const vec2 d = bezier.d;
	
	vec2 center = (b + c) * 0.5;
	if (t < 0.5)
	{
		const float s = t * 2.0;
		const float ss = s * s;
		const float u = 1.0 - s;
		const float uu = u * u;
		
		return (uu * a + 2.0 * u * s * b + ss * center).y;
	}
	else
	{
		const float s = (t - 0.5) * 2.0;
		const float ss = s * s;
		const float u = 1.0 - s;
		const float uu = u * u;
		
		return (uu * center + 2.0 * u * s * c + ss * d).y;
	}
}

vec2 GetCloudVelocity()
{
	const float delta = 0.2777777777; // km/h -> m/sec
	const vec2 vel = setting.windVelKmh * delta;
	const float voxelSize = 1.0 / setting.tiling;
	const vec2 offset = vel * voxelSize * setting.time;
	return offset;
}

float GetSampleHeightRatio(float cloudInnerRadius, float cloudOuterRadius, vec3 samplePos)
{
	const float cloudThickness = cloudOuterRadius - cloudInnerRadius;
	const vec3 PLANET_CENTER = vec3(0.0, -atmosphere.groundRadius, 0.0);
	const float sampleRadius = length(samplePos - PLANET_CENTER);
	const float heightRatio = clamp((sampleRadius - cloudInnerRadius) / cloudThickness, 0.0, 1.0);
	return heightRatio;
}

float GetHeightMask(float cloudInnerRadius, float cloudOuterRadius, vec3 samplePos)
{
	const float heightRatio = GetSampleHeightRatio(cloudInnerRadius, cloudOuterRadius, samplePos);
	
	const float bottomFade = smoothstep(0.0, 0.15, heightRatio);
	const float topFade = 1.0 - smoothstep(0.85, 1.0, heightRatio);
	const float heightMask = bottomFade * topFade;
	return heightMask;
}

float GetCloudMask(vec3 samplePos)
{
	return 0.f;
	const float worldSizeMeter = 128 * 1000.0;
	const vec2 uv = vec2(samplePos.x, samplePos.z) / worldSizeMeter + 0.5;
	const float mask = texture(cloudMaskTex, uv).r;
	
	return smoothstep(0.0, 1.0, mask);
}


float GetCoverage(float cloudInnerRadius, float cloudOuterRadius, vec3 samplePos)
{
	const float mask = GetCloudMask(samplePos);
	float coverage = clamp(setting.coverage - mask * 0.3, 0.0, 1.0);
	const float height = GetSampleHeightRatio(cloudInnerRadius, cloudOuterRadius, samplePos);
	coverage = 1.0 - pow(coverage, Remap(height, 0.7, 0.8, 1.0, mix(1.0, 0.5, setting.anvilBias)));
	return coverage;
}

float GetDensity(float cloudInnerRadius, float cloudOuterRadius, vec3 samplePos)
{
	const float heightMask = GetHeightMask(cloudInnerRadius, cloudOuterRadius, samplePos);
	const vec3 uvw0 = samplePos / setting.tiling;
	const vec3 uvw1 = samplePos / setting.tiling2;
	
	const vec2 offset = GetCloudVelocity();
	const float perlinWorley = textureLod(perlin, uvw0 + vec3(offset.x, 0.0, offset.y), 0).r;
	const vec3 worley = texture(perlin, uvw1 + vec3(offset.x, 0.0, offset.y)).gba;
	
	const float wfbm = worley.r * 0.625 + worley.g * 0.125 + worley.b * 0.25;
	float cloud = Remap(perlinWorley, wfbm - 1.0, 1.0, 0.0, 1.0);
	float coverage = GetCoverage(cloudInnerRadius, cloudOuterRadius, samplePos);
	
	cloud = clamp(Remap(cloud, coverage, 1.0, 0.0, 1.0), 0.0, 1.0);
	return cloud * heightMask;
}
float GetDensityLOD(float cloudInnerRadius, float cloudOuterRadius, vec3 samplePos, float lod)
{
	const float heightMask = GetHeightMask(cloudInnerRadius, cloudOuterRadius, samplePos);
	
	const vec3 uvw0 = samplePos / (setting.tiling);
	const vec2 offset = GetCloudVelocity();
	const vec3 uvw = uvw0 + vec3(offset.x, 0.0, offset.y);
	float cloud = textureLod(perlin, uvw, lod).r;
	const float coverage = GetCoverage(cloudInnerRadius, cloudOuterRadius, samplePos);
	
	cloud = clamp(Remap(cloud, coverage, 1.0, 0.0, 1.0), 0.0, 1.0);
	return cloud * heightMask;
}

float CloudToSunTransmittance(vec3 a, vec3 b, float distance, uint steps, float cloudInnerRadius, float cloudOuterRadius)
{
	//const float stepSize = distance / steps;
	const vec3 dir = (b - a) / distance;
	
	float transmittance = 1.0;
	const float cone = tan(radians(45));
	const float voxelSize = setting.tiling / 128.0;
	//const float distribution = 3.0;
    //const float expDistribution = exp(distribution);
	for (uint i = 0; i < steps; ++i)
	{
		float u0 = float(i) / float(steps);
		float u1 = float(i + 1) / float(steps);
		
		float t0 = distance * u0 * u0;
		float t1 = distance * u1 * u1;
		
		const float dt = t1 - t0;
		const float t = (t0 + t1) * 0.5;
		
		const vec3 samplePos = a + dir * t;
		const float coneRadius = t * cone;
		
		const float lod = min(log2(1 + coneRadius / voxelSize), 7.0);
		const float density = GetDensityLOD(cloudInnerRadius, cloudOuterRadius, samplePos, lod);
		const float sigmaA = 4.4 * 1e-6 * setting.extinctionCoefficient;
		const float sigmaT = density * sigmaA;
		const float stepT = exp(-sigmaT * dt); // max(exp(-sigmaT * stepSize), exp(-sigmaT * stepSize * 0.25) * 0.7);
		transmittance *= stepT;
		if (transmittance < 0.01)
			return 0.0;
	}
	return transmittance;
}

vec2 GetTransmittanceUV(vec3 samplePos, vec3 dir)
{
	const vec3 PLANET_CENTER = vec3(0.0, -atmosphere.groundRadius, 0.0);
	
	const float sampleLength = length(samplePos - PLANET_CENTER);
	const float height = sampleLength - atmosphere.groundRadius;
	const vec3 up = (samplePos - PLANET_CENTER) / sampleLength;
	const float mu = dot(up, dir);
	
	const float r = height + atmosphere.groundRadius;
	// 지평선에서 대기까지의 거리 H
	const float H = sqrt(atmosphere.atmosphereRadius * atmosphere.atmosphereRadius - atmosphere.groundRadius * atmosphere.groundRadius);
	// 지평선 거리 rho
	const float rho = sqrt(r * r - atmosphere.groundRadius * atmosphere.groundRadius);
	
	const float dMin = atmosphere.atmosphereRadius - r; // 머리 위의 대기까지의 거리
	const float dMax = rho + H; // 지평선 너머의 대기까지의 거리
	float d = -r * mu + sqrt(r * r * (mu * mu - 1) + atmosphere.atmosphereRadius * atmosphere.atmosphereRadius); // 샘플에서 ray방향으로의 대기권까지의 거리
	d = max(d, 0.0);
	
	float u = (d - dMin) / (dMax - dMin); // 0(머리위) ~ 1(지평선)
	float v = rho / H; // 그냥 높이 비율 대신 제곱근 비율로 바뀐거
	v = 1.0 - v;
	return vec2(u, v);
}

vec3 TransmittanceUsingLUT(vec3 samplePos, vec3 dir)
{
	const ivec2 size = textureSize(transmittanceLUT, 0);
	vec2 uv = GetTransmittanceUV(samplePos, dir);
	uv = (vec2(0.5) + uv * (size - vec2(1.0))) / size;
	
	return texture(transmittanceLUT, uv).xyz;
}

void SegmentTransmittance(
	vec3 rayOrigin, 
	vec3 rayDir, 
	vec2 segment, 
	float steps, 
	vec2 noise,
	vec3 sunDir, 
	float phase,
	float mu,
	inout vec3 inScattering,
	inout float transmittance,
	inout float depthSum,
	inout float weightSum)
{
	const vec3 PLANET_CENTER = vec3(0.0, -atmosphere.groundRadius, 0.0);
	const float cloudInner = atmosphere.groundRadius + CLOUD_HEIGHT;
	const float cloudOuter = cloudInner + CLOUD_THICKNESS;
	const float segmentLength = segment.y - segment.x;
	const float targetStepLength = 100.0;
	const uint maxStep = max(uint(steps), 1u);
	const uint minStep = min(5u, maxStep);
	steps = clamp(uint(ceil(segmentLength / targetStepLength)), minStep, maxStep);
	const float stepSize = segmentLength / steps;
	const bool lightViewLimit = (setting.modeFlags & 1) == 1;
	const float isotropicPhase = 1.0 / (4.0 * PI);
	
	for (uint i = 0; i < steps; ++i)
	{
		if (transmittance <= 0.01)
            break;
		const float t = segment.x + stepSize * (i + noise.r);
		const vec3 samplePos = rayOrigin + rayDir * t;
		float density = GetDensity(cloudInner, cloudOuter, samplePos);
		
		if (density <= 0.001)
			continue;
		
		float lightViewT = 1.0;
		float groundNear;
		float groundFar;
		
		if (RaySphereIntersect(samplePos, -sunDir, PLANET_CENTER, atmosphere.groundRadius, groundNear, groundFar))
			lightViewT = 0.0;
		else
		{
			vec2 seg0;
			vec2 seg1;
			int segCount = RayCloudShellIntersect(samplePos, -sunDir, PLANET_CENTER, cloudInner, cloudOuter, seg0, seg1);
			if (segCount >= 1)
			{
				float seg0Length = seg0.y - seg0.x;
				seg0Length = lightViewLimit ? min(3000, seg0Length) : seg0Length;
				const vec3 seg0Pos = samplePos - sunDir * seg0.x;
				const float seg0CloudLightViewT = CloudToSunTransmittance(
					seg0Pos, seg0Pos - sunDir * seg0Length, 
					seg0Length, setting.lightViewSteps, cloudInner, cloudOuter);
				lightViewT *= seg0CloudLightViewT;
				
				if (segCount == 2 && lightViewT > 0.01)
				{
					float seg1Length = seg1.y - seg1.x;
					seg1Length = lightViewLimit ? min(1000, seg1Length) : seg1Length;
					const vec3 seg1Pos = samplePos - sunDir * seg1.x;
					const float seg1CloudLightViewT = CloudToSunTransmittance(
						seg1Pos, seg1Pos - sunDir * seg1Length, 
						seg1Length, setting.lightViewSteps, cloudInner, cloudOuter);
					lightViewT *= seg1CloudLightViewT;
				}
			}
		}
		
		const vec3 cloudT = TransmittanceUsingLUT(samplePos, -sunDir);
		const float sigmaA = 4.4 * 1e-6 * setting.extinctionCoefficient;
		const float sigmaT = density * sigmaA;
		const float stepTransmittance = exp(-sigmaT * stepSize);
		const float stepTransmittanceAlpha = 1.0 - stepTransmittance;
		const float depthWeight = transmittance * stepTransmittanceAlpha;
		depthSum += t * depthWeight;
		weightSum += depthWeight;
		
		const float lightViewOpticalDepth = -log(max(lightViewT, 1e-4));
		float powder = 1.0 - exp(-2.0 * lightViewOpticalDepth);
		powder = mix(powder, 1.0, (mu + 1.0) * 0.5);
		powder = mix(1.0, powder, setting.powderStrength);
		
		float lightingSource = lightViewT * phase * lighting.sun.w;
		lightingSource += 0.2 * pow(max(lightViewT, 1e-4), 0.3) * isotropicPhase * lighting.sun.w;
		
		const float heightRatio = GetSampleHeightRatio(cloudInner, cloudOuter, samplePos);
		const float verticalP = setting.darkness * BezierCurve(setting.darknessHeight, heightRatio);
		const float densityP = setting.densityPMin + pow(density, setting.densityPFactor);
		inScattering += transmittance * stepTransmittanceAlpha * powder * cloudT * lightingSource * (verticalP * densityP);
		transmittance *= stepTransmittance;
	}
}

int ClipCloudSegments(float maxDistance, inout vec2 segment0, inout vec2 segment1, int segmentCount)
{
	if (segmentCount <= 0 || maxDistance <= segment0.x)
		return 0;
	segment0.y = min(segment0.y, maxDistance);
	if (segment0.y <= segment0.x)
		return 0;
	if (segmentCount == 1 || maxDistance <= segment1.x)
		return 1;
	segment1.y = min(segment1.y, maxDistance);
	if (segment1.y <= segment1.x)
		return 1;
	return 2;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if ((setting.frameIdx & 1) == 0)
		pixel.x = pixel.x * 2;
	else
		pixel.x = pixel.x * 2 + 1;
	ivec2 size = imageSize(outImage);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	// float perlinWorley = texture(perlin, vec3(uv * 5.0, 0.0)).r;
	// vec3 worley = texture(perlin, vec3(uv, 0.0)).gba;
	
	// float wfbm = worley.r * 0.625 + worley.g * 0.125 + worley.b * 0.25;
	// float cloud = Remap(perlinWorley, wfbm - 1.0, 1.0, 0.0, 1.0);
	// cloud = clamp(Remap(cloud, 1.0 - setting.coverage, 1.0, 0.0, 1.0), 0.0, 1.0);
	// imageStore(outImage, pixel, vec4(vec3(cloud), 1.0));
	// return;
	
	const vec3 viewRay = PixelToViewPos(uv, 1.0);
	const vec3 rayDir = normalize((camera.invView * vec4(viewRay, 0.0)).xyz);
	const float cloudInnerRadius = atmosphere.groundRadius + CLOUD_HEIGHT;
	const float cloudOuterRadius = cloudInnerRadius + CLOUD_THICKNESS;
	const vec3 PLANET_CENTER = vec3(0.0, -atmosphere.groundRadius, 0.0);
	const ivec2 noisePixel = pixel % textureSize(noiseTex, 0);
	const vec2 bluseNoise = texelFetch(noiseTex, noisePixel, 0).rg;

	const vec2 noise = fract(bluseNoise + setting.frameIdx * 0.61803398875);
	vec2 cloudSegment0 ;
	vec2 cloudSegment1;
	int cloudSegmentCount = 
		RayCloudShellIntersect(camera.pos, rayDir, PLANET_CENTER, cloudInnerRadius, cloudOuterRadius, cloudSegment0, cloudSegment1);
	if (cloudSegmentCount == 0)
	{
		imageStore(outImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outCloudDepth, pixel, vec4(-1.0));
		return;
	}

	const float z = texture(sceneDepth, uv).r;
	const vec3 viewPos = PixelToViewPos(uv, z);
	const float sceneDistance = length(viewPos);
	if (z < 1.0)
		cloudSegmentCount = ClipCloudSegments(sceneDistance, cloudSegment0, cloudSegment1, cloudSegmentCount);
	if (cloudSegmentCount == 0)
	{
		imageStore(outImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outCloudDepth, pixel, vec4(-1.0));
		return;
	}
	
	// float mask = GetCloudMask(camera.pos + rayDir * cloudSegment0.x);
		// // imageStore(outImage, pixel, vec4(vec3(mask), 1.0));
		// // imageStore(outCloudDepth, pixel, vec4(-1.0));
		// // return;
	// if (mask < 1e-4)
	// {
		// imageStore(outImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
		// imageStore(outCloudDepth, pixel, vec4(-1.0));
		// return;
	// }

	
	const vec3 sunDir = lighting.sun.xyz;
	const float mu = dot(rayDir, -sunDir);
	const float phase = mix(MiePhase(mu, 0.8), MiePhase(mu, -0.2), 0.5);

	vec3 inScattering = vec3(0.0);
	float transmittance = 1.0;
	float depthSum = 0.0;
	float weightSum = 0.0;
	if (cloudSegmentCount == 1)
	{
		SegmentTransmittance(
			camera.pos, rayDir, cloudSegment0, setting.steps, noise,
			sunDir, phase, mu, 
			inScattering, transmittance, depthSum, weightSum);
	}
	else if (cloudSegmentCount == 2)
	{
		SegmentTransmittance(
			camera.pos, rayDir, cloudSegment0, setting.steps, noise,
			sunDir, phase, mu,
			inScattering, transmittance, depthSum, weightSum);
		SegmentTransmittance(
			camera.pos, rayDir, cloudSegment1, setting.steps, noise,
			sunDir, phase, mu,
			inScattering, transmittance, depthSum, weightSum);
	}

	const float fallbackDepth = mix(cloudSegment0.x, cloudSegment0.y, 0.3);
	const float weightedDepth = depthSum / max(weightSum, 1e-5);
	const float depthReliability = smoothstep(0.005, 0.05, weightSum);
	const float depth = mix(fallbackDepth, weightedDepth, depthReliability);
	
	imageStore(outImage, pixel, vec4(inScattering, transmittance));
	imageStore(outCloudDepth, pixel, vec4(depth));
}
